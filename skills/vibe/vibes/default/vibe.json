{
  "name": "default",
  "displayName": "Default",
  "description": "The standard statusline. Progress bar, model info, cost, tokens, and moon phase animation.",
  "author": "yyou",
  "statusline": {
    "segments": [
      {
        "type": "progress-bar",
        "width": 20,
        "colors": {
          "low": "#22c55e",
          "mid": "#eab308",
          "high": "#ef4444",
          "thresholds": [60, 80]
        }
      },
      {
        "type": "text",
        "template": "{ctx_pct}% | {model} | {cost} | {tokens}"
      },
      {
        "type": "animation",
        "frames": ["🌑", "🌒", "🌓", "🌔", "🌕", "🌖", "🌗", "🌘"],
        "interval": 0.5,
        "trigger": "time"
      }
    ]
  },
  "install": "npx vibing-supply use default"
}
